{
	email {$ACME_EMAIL}

	# Caddy's own version is not useful to a client and is useful to a scanner.
	servers {
		trusted_proxies static private_ranges
	}
}

# Applied to both sites. HSTS is set here rather than per-application because Caddy is what terminates
# TLS and therefore the only thing that knows the connection was secure.
(security_headers) {
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		-Server
	}
}

{$APP_DOMAIN} {
	encode gzip
	import security_headers
	reverse_proxy frontend:80 {
		health_uri /
		health_interval 10s
		health_timeout 5s
	}
}

{$API_DOMAIN} {
	encode gzip
	import security_headers

	header {
		# The API returns data, never a document, so nothing it serves should ever be rendered or framed.
		Content-Security-Policy "default-src 'none'; frame-ancestors 'none'"
		X-Frame-Options "DENY"
		Cross-Origin-Resource-Policy "same-site"
	}

	# Metrics stay on the internal network; scrape from Prometheus, not the public hostname.
	handle /metrics* {
		respond 404
	}

	# Active health checks so a gateway that is restarting (or still applying migrations) is taken out
	# of rotation instead of serving errors. This is what makes one-service-at-a-time replacement safe.
	reverse_proxy apigateway:8080 {
		health_uri /health/ready
		health_interval 10s
		health_timeout 5s

		transport http {
			versions 1.1
		}
	}
}

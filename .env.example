# Copy to .env and fill with strong production values. Never commit .env.

# Domains (DNS must point to your VPS)
APP_DOMAIN=app.example.com
API_DOMAIN=api.example.com
ACME_EMAIL=admin@example.com

# Public URLs (used by Caddy, CORS, frontend build)
FRONTEND_URL=https://app.example.com
API_PUBLIC_URL=https://api.example.com
VITE_API_URL=https://api.example.com

# JWT (min 32 characters)
JWT_SECRET=CHANGE_ME_use_openssl_rand_base64_32
JWT_ISSUER=EduPlatform
JWT_AUDIENCE=EduPlatformUsers

# Shared key for service-to-service calls (account/profile sync between Auth and User).
# Generate with: openssl rand -base64 32
INTERNAL_API_KEY=CHANGE_ME_use_openssl_rand_base64_32

# PostgreSQL
POSTGRES_USER=postgres
POSTGRES_PASSWORD=CHANGE_ME_strong_postgres_password

# MinIO
MINIO_ROOT_USER=CHANGE_ME_minio_user
MINIO_ROOT_PASSWORD=CHANGE_ME_minio_password
MINIO_BUCKET=eduplatform

# Admin seed (Auth + UserService) — password is never stored in appsettings.
# Keep this false in production; flip it on for one boot to create the first admin, then turn it back off.
SEED_ENABLED=true
SEED_ADMIN_EMAIL=admin@eduplatform.local
SEED_ADMIN_PASSWORD=CHANGE_ME_set_a_local_dev_password

# Jitsi (leave empty to disable JWT-signed rooms; public meet.jit.si still works)
JITSI_APP_ID=
JITSI_APP_SECRET=
VITE_JITSI_DOMAIN=meet.jit.si

# Frontend Content-Security-Policy origins (space-separated). Defaults match API_DOMAIN + Jitsi.
# CSP_CONNECT_SRC=https://api.example.com wss://api.example.com
# CSP_FRAME_SRC=https://meet.jit.si

# Optional: OpenTelemetry (set when running `docker compose --profile obs up`)
# OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4317
# OTEL_SERVICE_NAME=eduplatform

# SMTP (AuthService outbox). Leave SMTP_HOST empty to skip sending in local/dev.
SMTP_HOST=
SMTP_PORT=587
SMTP_FROM=noreply@eduplatform.local
SMTP_USER=
SMTP_PASSWORD=
SMTP_ENABLE_SSL=true
EMAIL_REQUIRE_VERIFICATION=false

# RabbitMQ (optional; outbox still sends via SMTP when this is empty).
# RABBITMQ_USER/PASSWORD seed the broker itself when running `--profile messaging`;
# RABBITMQ_URL is what the services connect with and must match them.
RABBITMQ_USER=eduplatform
RABBITMQ_PASSWORD=CHANGE_ME_strong_rabbitmq_password
# RABBITMQ_URL=amqp://eduplatform:CHANGE_ME_strong_rabbitmq_password@rabbitmq:5672/

# Backups (scripts/backup-postgres.sh, scripts/backup-minio.sh)
BACKUP_DIR=./backups
BACKUP_RETENTION_DAYS=14
# BACKUP_GPG_RECIPIENT=ops@example.com

root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space

[*.{cs,csx}]
indent_size = 4

[*.{json,jsonc,yml,yaml,ts,tsx,js,jsx,css,html,md}]
indent_size = 2

[*.{csproj,props,targets,sln}]
indent_size = 2

[*.sh]
indent_size = 2

[*.md]
trim_trailing_whitespace = false

[*.cs]
# Namespaces and usings
csharp_style_namespace_declarations = file_scoped:warning
dotnet_sort_system_directives_first = true
csharp_using_directive_placement = outside_namespace:warning

# Prefer var only when the type is apparent
csharp_style_var_for_built_in_types = false:silent
csharp_style_var_when_type_is_apparent = true:suggestion
csharp_style_var_elsewhere = false:silent

# Modern C# expression preferences
csharp_style_expression_bodied_methods = when_on_single_line:suggestion
csharp_style_expression_bodied_properties = true:suggestion
csharp_style_prefer_switch_expression = true:suggestion
csharp_style_prefer_pattern_matching = true:suggestion
csharp_style_throw_expression = true:suggestion
csharp_prefer_simple_using_statement = true:suggestion
csharp_prefer_braces = when_multiline:suggestion

# Null checking
csharp_style_conditional_delegate_call = true:suggestion
dotnet_style_coalesce_expression = true:suggestion
dotnet_style_null_propagation = true:suggestion

# Readonly / accessibility
dotnet_style_readonly_field = true:suggestion
dotnet_style_require_accessibility_modifiers = for_non_interface_members:suggestion
dotnet_style_predefined_type_for_locals_parameters_members = true:suggestion

# Naming: private fields use _camelCase
dotnet_naming_rule.private_fields_underscore.symbols = private_fields
dotnet_naming_rule.private_fields_underscore.style = underscore_camel_case
dotnet_naming_rule.private_fields_underscore.severity = suggestion
dotnet_naming_symbols.private_fields.applicable_kinds = field
dotnet_naming_symbols.private_fields.applicable_accessibilities = private
dotnet_naming_style.underscore_camel_case.required_prefix = _
dotnet_naming_style.underscore_camel_case.capitalization = camel_case

# Async methods must be awaited or explicitly discarded
dotnet_diagnostic.CS4014.severity = error
# ConfigureAwait is not needed in ASP.NET Core
dotnet_diagnostic.CA2007.severity = none
# Culture-specific string comparisons: enforce explicit intent
dotnet_diagnostic.CA1304.severity = suggestion
dotnet_diagnostic.CA1305.severity = suggestion
dotnet_diagnostic.CA1310.severity = suggestion
# Logging message templates should be compile-time constants
dotnet_diagnostic.CA2254.severity = warning
# Do not expose generic List<T> on public APIs: DTOs intentionally do
dotnet_diagnostic.CA1002.severity = none
dotnet_diagnostic.CA1062.severity = none
# "Shared" collides with a VB keyword; renaming the shared library is not worth the churn
dotnet_diagnostic.CA1716.severity = none
# Entity models spell out default values so the persisted shape is obvious at a glance
dotnet_diagnostic.CA1805.severity = none
# LoggerMessage source generation: Serilog structured templates are the established pattern here
dotnet_diagnostic.CA1848.severity = none
dotnet_diagnostic.CA1873.severity = none
# Constant array allocations in cold paths are not worth hoisting to static fields
dotnet_diagnostic.CA1861.severity = suggestion

[tests/**/*.cs]
# Tests intentionally use literal values and simplified names
dotnet_diagnostic.CA1707.severity = none
dotnet_diagnostic.CA1861.severity = none

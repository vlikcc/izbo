# Rendered at container start by the nginx image's envsubst entrypoint, so the Content-Security-Policy
# can name the actual API and conferencing origins instead of allowing every https origin.
#
#   CSP_CONNECT_SRC  origins the app may call, e.g. "https://api.example.com wss://api.example.com"
#   CSP_FRAME_SRC    origins the app may embed, e.g. "https://meet.jit.si"
#   CSP_MEDIA_SRC    origins <video>/<audio> may load from, e.g. "https://api.example.com" — hls.js plays
#                    through blob: URLs, but native HLS (Safari) fetches playlists from the API directly
#   APP_API_URL      the API's public URL, handed to the app through /config.js at runtime, so one image
#                    serves any domain; empty falls back to the URL baked in at build time (VITE_API_URL)

# The public scheme as the visitor sees it: TLS ends at the proxy (Caddy/Traefik) in front of this container.
map $http_x_forwarded_proto $public_scheme {
    default $http_x_forwarded_proto;
    ""      $scheme;
}

server {
    listen 80;
    server_name localhost;
    root /usr/share/nginx/html;
    index index.html;

    # Nothing here is a secret, but the version is free reconnaissance.
    server_tokens off;

    gzip on;
    gzip_types text/plain text/css application/json application/javascript text/xml application/xml application/xml+rss text/javascript;

    # Runtime settings for the app, rendered from the container's environment at start-up. The exact
    # match wins over the long-cache *.js rule below; `expires` (not add_header) keeps the server-level
    # security headers inherited.
    location = /config.js {
        default_type application/javascript;
        expires -1;
        return 200 'window.__APP_CONFIG__ = { apiUrl: "${APP_API_URL}" };';
    }

    # Handle SPA routing
    location / {
        try_files $uri $uri/ /index.html;
    }

    # robots.txt and sitemap.xml are built from the request's own host, so the image needs no domain setting.
    # No add_header here: one would stop the server-level security headers from being inherited.
    location = /robots.txt {
        default_type text/plain;
        return 200 "User-agent: *\nAllow: /\nDisallow: /app/\nDisallow: /live/\nDisallow: /quiz/\nDisallow: /join/\n\nSitemap: $public_scheme://$http_host/sitemap.xml\n";
    }

    location = /sitemap.xml {
        default_type application/xml;
        return 200 '<?xml version="1.0" encoding="UTF-8"?>
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">
<url><loc>$public_scheme://$http_host/</loc></url>
<url><loc>$public_scheme://$http_host/lgs</loc></url>
<url><loc>$public_scheme://$http_host/yks</loc></url>
<url><loc>$public_scheme://$http_host/sinif/1-sinif</loc></url>
<url><loc>$public_scheme://$http_host/sinif/2-sinif</loc></url>
<url><loc>$public_scheme://$http_host/sinif/3-sinif</loc></url>
<url><loc>$public_scheme://$http_host/sinif/4-sinif</loc></url>
<url><loc>$public_scheme://$http_host/sinif/5-sinif</loc></url>
<url><loc>$public_scheme://$http_host/sinif/6-sinif</loc></url>
<url><loc>$public_scheme://$http_host/sinif/7-sinif</loc></url>
<url><loc>$public_scheme://$http_host/sinif/8-sinif</loc></url>
<url><loc>$public_scheme://$http_host/sinif/9-sinif</loc></url>
<url><loc>$public_scheme://$http_host/sinif/10-sinif</loc></url>
<url><loc>$public_scheme://$http_host/sinif/11-sinif</loc></url>
<url><loc>$public_scheme://$http_host/sinif/12-sinif</loc></url>
<url><loc>$public_scheme://$http_host/pricing</loc></url>
</urlset>
';
    }

    # The base image's mime.types maps .js but not .mjs, so dynamically-imported ES module chunks
    # (e.g. pdfjs-dist's worker) are served as application/octet-stream and browsers refuse to
    # execute them as modules. The types{} override is scoped to this location alone so it doesn't
    # clobber the inherited mime.types map for every other extension.
    location ~* \.mjs$ {
        types {
            application/javascript mjs;
        }
        expires 1y;
        add_header Cache-Control "public, immutable" always;
    }

    # Hashed asset file names make these safe to cache indefinitely.
    location ~* \.(js|css|png|jpg|jpeg|gif|ico|svg|woff|woff2)$ {
        expires 1y;
        add_header Cache-Control "public, immutable" always;
    }

    # index.html must never be cached, or a deploy leaves clients loading asset names that are gone.
    location = /index.html {
        add_header Cache-Control "no-cache, no-store, must-revalidate" always;
    }

    add_header X-Frame-Options "DENY" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;
    add_header Cross-Origin-Opener-Policy "same-origin" always;
    add_header Permissions-Policy "camera=(self), microphone=(self), display-capture=(self), geolocation=(), payment=()" always;

    # script-src carries no 'unsafe-inline' or 'unsafe-eval': the build emits only module scripts, so an
    # injected <script> or a string passed to eval cannot run. Inline styles are still allowed as
    # attributes (React style props) but not as <style> blocks; style-src is the fallback for browsers
    # that do not implement the -elem/-attr split.
    add_header Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; style-src-elem 'self' https://fonts.googleapis.com; style-src-attr 'unsafe-inline'; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: blob: https:; media-src 'self' blob: ${CSP_MEDIA_SRC}; worker-src 'self' blob:; connect-src 'self' ${CSP_CONNECT_SRC}; frame-src 'self' ${CSP_FRAME_SRC}; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'; upgrade-insecure-requests" always;
}
